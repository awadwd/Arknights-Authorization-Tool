{
    "name" : "方舟通行证谷子查询工具",
    "appid" : "__UNI__0E47E24",
    "description" : "明日方舟通行证查询app",
    "versionName" : "1.50.54",
    "versionCode" : 165,
    "transformPx" : false,
    /* 5+App特有相关 */
    "app-plus" : {
        "usingComponents" : true,
        "nvueStyleCompiler" : "uni-app",
        "compilerVersion" : 3,
        /* 启动页：waiting 关掉，否则启动图上会叠一个菊花；
           alwaysShowBeforeRender 保留，避免首屏白屏。 */
        "splashscreen" : {
            "alwaysShowBeforeRender" : true,
            "waiting" : false,
            "autoclose" : true,
            "delay" : 0
        },
        /* 模块配置 */
        "modules" : {
            "Barcode" : {}
        },
        /* 应用发布信息 */
        "distribute" : {
            /* android打包配置 */
            "android" : {
                /* 包名必须写死在这里：不写的话云打包会用默认的 uni.app.<appid>，
                   和线上 1.50.51（com.ArknightsAuthorizationSeries）不一致，
                   装上去会变成两个 App、数据也不通。 */
                "packagename" : "com.ArknightsAuthorizationSeries",
                "schemes" : "akpassport",
                "permissions" : [
                    "<uses-permission android:name=\"android.permission.CHANGE_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.MOUNT_UNMOUNT_FILESYSTEMS\"/>",
                    "<uses-permission android:name=\"android.permission.VIBRATE\"/>",
                    "<uses-permission android:name=\"android.permission.READ_LOGS\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_WIFI_STATE\"/>",
                    "<uses-feature android:name=\"android.hardware.camera.autofocus\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.CAMERA\"/>",
                    "<uses-permission android:name=\"android.permission.GET_ACCOUNTS\"/>",
                    "<uses-permission android:name=\"android.permission.READ_PHONE_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.CHANGE_WIFI_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.WAKE_LOCK\"/>",
                    "<uses-permission android:name=\"android.permission.FLASHLIGHT\"/>",
                    "<uses-feature android:name=\"android.hardware.camera\"/>",
                    "<uses-permission android:name=\"android.permission.WRITE_SETTINGS\"/>",
                    "<uses-permission android:name=\"android.permission.REQUEST_INSTALL_PACKAGES\"/>",
                    /* Android 13+ 通知要单独申请，不声明的话 checkSelfPermission 永远返回
                       未授予，系统设置里也找不到本应用的通知开关 —— 通知等于静默失效 */
                    "<uses-permission android:name=\"android.permission.POST_NOTIFICATIONS\"/>"
                ]
            },
            /* ios打包配置 */
            "ios" : {
                "dSYMs" : false
            },
            /* SDK配置 */
            "sdkConfigs" : {
                "ad" : {}
            },
            "icons" : {
                "android" : {
                    "xxhdpi" : "unpackage/res/icons/144x144.png",
                    "hdpi" : "unpackage/res/icons/72x72.png",
                    "xhdpi" : "unpackage/res/icons/96x96.png",
                    "xxxhdpi" : "unpackage/res/icons/192x192.png"
                },
                "ios" : {
                    "appstore" : "unpackage/res/icons/1024x1024.png",
                    "ipad" : {
                        "app" : "unpackage/res/icons/76x76.png",
                        "app@2x" : "unpackage/res/icons/152x152.png",
                        "notification" : "unpackage/res/icons/20x20.png",
                        "notification@2x" : "unpackage/res/icons/40x40.png",
                        "proapp@2x" : "unpackage/res/icons/167x167.png",
                        "settings" : "unpackage/res/icons/29x29.png",
                        "settings@2x" : "unpackage/res/icons/58x58.png",
                        "spotlight" : "unpackage/res/icons/40x40.png",
                        "spotlight@2x" : "unpackage/res/icons/80x80.png"
                    },
                    "iphone" : {
                        "app@2x" : "unpackage/res/icons/120x120.png",
                        "app@3x" : "unpackage/res/icons/180x180.png",
                        "notification@2x" : "unpackage/res/icons/40x40.png",
                        "notification@3x" : "unpackage/res/icons/60x60.png",
                        "settings@2x" : "unpackage/res/icons/58x58.png",
                        "settings@3x" : "unpackage/res/icons/87x87.png",
                        "spotlight@2x" : "unpackage/res/icons/80x80.png",
                        "spotlight@3x" : "unpackage/res/icons/120x120.png"
                    }
                }
            },
            /* 自定义启动图（三档密度）。
               androidTranslucent: 避免先闪一下系统默认的「白底+图标」。
               androidStyle default: 用整图铺满，不做 9-patch 拉伸。 */
            "splashscreen" : {
                "androidStyle" : "default",
                "useOriginalMsgbox" : false,
                "androidTranslucent" : true,
                "android" : {
                    "hdpi" : "static/splash/hdpi.png",
                    "xhdpi" : "static/splash/xhdpi.png",
                    "xxhdpi" : "static/splash/xxhdpi.png"
                }
            }
        }
    },
    /* 快应用特有相关 */
    "quickapp" : {},
    /* 小程序特有相关 */
    "mp-weixin" : {
        "appid" : "wxf44733fe3bc08ad9",
        "setting" : {
            "urlCheck" : false,
            "minified" : true
        },
        /* 分享页改走 canvas 2D 绘制，已不再需要 Skyline 渲染器，
           故移除 rendererOptions（Skyline 的 AB 实验会让真机回退 WebView）。 */
        "usingComponents" : true,
        "lazyCodeLoading" : "requiredComponents",
        "__usePrivacyCheck__" : true
    },
    "mp-alipay" : {
        "usingComponents" : true
    },
    "mp-baidu" : {
        "usingComponents" : true
    },
    "mp-toutiao" : {
        "usingComponents" : true,
        "appid" : "tt502a2697ce54b93b01"
    },
    "uniStatistics" : {
        "enable" : false
    },
    "vueVersion" : "3",
    "h5" : {
        /* 桌面端（WinUI 壳）：窗口拉宽时不再让 rpx 无限放大 */
        "rpxCalcMaxDeviceWidth" : 750,
        "rpxCalcBaseDeviceWidth" : 375,
        "rpxCalcIncludeWidth" : 750,
        "router" : {
            "base" : "./",
            "mode" : "hash"
        },
        "devServer" : {
            // ← devServer 与 router 平级
            "port" : 5173,
            "disableHostCheck" : true,
            "proxy" : {
                "/api" : {
                    "target" : "https://21680db9b1362913357c.myminapp.com",
                    "changeOrigin" : true,
                    "secure" : false,
                    "pathRewrite" : {
                        "^/api" : "/hserve/v2.2"
                    }
                },
                "/gitcode" : {
                    "target" : "https://raw.gitcode.com",
                    "changeOrigin" : true,
                    "secure" : false,
                    "pathRewrite" : {
                        "^/gitcode" : ""
                    }
                }
            }
        }
    }
}
