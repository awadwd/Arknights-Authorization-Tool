<?xml version="1.0" encoding="utf-8"?>
<Window
	x:Class="AkPassport.Win.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:views="using:AkPassport.Win.Views"
	Title="方舟通行证谷子查询工具">

	<Grid x:Name="Root" Background="#ECF1F7" RequestedTheme="Light">
		<Grid.RowDefinitions>
			<RowDefinition Height="36" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- 自绘标题栏：与侧边栏同色，作为窗口拖动区域 -->
		<Grid x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="#FAFCFF">
			<StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
				<Image Source="Assets/tray.png" Width="16" Height="16" />
				<TextBlock x:Name="TitleText" Text="方舟通行证谷子查询工具" FontSize="12"
				           Foreground="#4B5563" VerticalAlignment="Center" />
			</StackPanel>
		</Grid>

		<!-- 标题栏右侧动作区：刻意放在 AppTitleBar 之外（同格、后声明 = 更靠上层），
		     否则整条拖动区会吞掉按钮的点击。右边距给系统三个窗口按钮留位。 -->
		<StackPanel Grid.Row="0" Grid.ColumnSpan="2"
		            Orientation="Horizontal" Spacing="4"
		            HorizontalAlignment="Right" VerticalAlignment="Center"
		            Margin="0,0,146,0">
			<Button x:Name="AeSwitchButton" Click="OnAeSwitchClick"
			        Background="Transparent" BorderThickness="0" Padding="8,3" CornerRadius="6"
			        AutomationProperties.Name="切换工具包"
			        ToolTipService.ToolTip="切换工具包：方舟通行证 ⇄ 终末地工具箱">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<Image x:Name="AeSwitchIcon" Width="16" Height="16"
					       Source="ms-appx:///Assets/endfield-avatar.png" />
					<Image x:Name="AkSwitchIcon" Width="16" Height="16" Visibility="Collapsed"
					       Source="ms-appx:///Assets/arknights-avatar.png" />
					<TextBlock x:Name="AeSwitchText" Text="终末地" FontSize="11.5"
					           VerticalAlignment="Center" />
				</StackPanel>
			</Button>
		</StackPanel>

		<NavigationView
			x:Name="Nav"
			Grid.Row="1"
			Grid.Column="0"
			PaneDisplayMode="Left"
			IsBackButtonVisible="Collapsed"
			IsSettingsVisible="False"
			IsPaneToggleButtonVisible="True"
			OpenPaneLength="212"
			CompactPaneLength="52"
			IsPaneOpen="True"
			SelectionChanged="OnNavSelectionChanged">

			<!-- 菜单项在 BuildNav() 里按「方舟 / 终末地」两套工具包动态生成 -->

			<NavigationView.FooterMenuItems>
				<NavigationViewItem Content="设置" Tag="settings">
					<NavigationViewItem.Icon>
						<SymbolIcon Symbol="Setting" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>
			</NavigationView.FooterMenuItems>
		</NavigationView>

		<Grid x:Name="ContentArea" Grid.Row="1" Grid.Column="1" Background="#ECF1F7" Padding="14,10,14,14">
			<!-- 内容卡片：像一块浮在背景上的卡片，四周留出间距。
			     宽度由 ApplyContentWidth 控制（ContentHost.Width），卡片自动贴合内容宽度。 -->
			<Border x:Name="ContentCard"
			        HorizontalAlignment="Center"
			        Background="#FAFCFF"
			        BorderBrush="#DDE4EE"
			        BorderThickness="1"
			        CornerRadius="12">
				<!-- 内容画布：固定宽度居中。uni-app 的 rpx 按视口宽度换算，
				     如果不限制宽度，1180px 的窗口会把整套移动端布局放大 1.5 倍。 -->
				<Grid>
				<Grid x:Name="ContentHost" Width="600" Background="#FAFCFF">
					<WebView2 x:Name="Web" />

					<Grid x:Name="Splash" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
							<ProgressRing IsActive="True" Width="36" Height="36" />
							<TextBlock x:Name="SplashText" Text="正在加载…" FontSize="13" Opacity="0.6" HorizontalAlignment="Center" />
						</StackPanel>
					</Grid>

					<Grid x:Name="ErrorLayer" Visibility="Collapsed"
					      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
						            MaxWidth="360" Spacing="14">
							<TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" Opacity="0.75"
							           HorizontalAlignment="Center" TextAlignment="Center" />
							<Button Content="重试" Click="OnRetryClick" HorizontalAlignment="Center" />
						</StackPanel>
					</Grid>
				</Grid>

				<!-- 原生设置页：覆盖在 WebView 上方，切走时折叠 -->
				<views:SettingsView x:Name="SettingsPage" Visibility="Collapsed"
				                    HorizontalAlignment="Center" />

				<!-- 终末地包的原生首页与设置（同一层，互斥显示） -->
				<views:AeHomeView x:Name="AeHomePage" Visibility="Collapsed"
				                  HorizontalAlignment="Center" />
				<views:AeSettingsView x:Name="AeSettingsPage" Visibility="Collapsed"
				                      HorizontalAlignment="Center" />
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>
