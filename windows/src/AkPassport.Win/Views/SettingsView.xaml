<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="AkPassport.Win.Views.SettingsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>
		<!-- 设置卡片：Win11 设置页的「分组卡片」外观 -->
		<Style x:Key="SettingsCard" TargetType="Border">
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="18,16,18,14" />
		</Style>

		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>

		<Style x:Key="SectionHint" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,-6,0,0" />
		</Style>

		<!-- 主题卡片：透明底 + 细边，选中时由代码加粗边框 -->
		<Style x:Key="ThemeCard" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Top" />
		</Style>

		<!-- 名单胶囊 / 规则操作这类小按钮：低调一点，不抢标题的视觉权重 -->
		<Style x:Key="ChipButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="14" />
			<Setter Property="Padding" Value="10,3" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="MinHeight" Value="0" />
		</Style>

		<Style x:Key="MiniButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="MinHeight" Value="0" />
		</Style>
	</UserControl.Resources>

	<ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
	              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
		<StackPanel x:Name="Page" Padding="30,24,30,40" Spacing="8" MaxWidth="920"
		            HorizontalAlignment="Stretch">

			<TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" />
			<TextBlock Text="Windows 版 · 只列出在桌面端真正有效的项目；改动会立即写回并刷新页面"
			           FontSize="12" Opacity="0.55" Margin="0,0,0,12" />

			<!-- ── 外观 ───────────────────────────────────────────── -->
			<Border x:Name="CardTheme" Style="{StaticResource SettingsCard}">
				<StackPanel Spacing="10">
					<TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
					<TextBlock Text="主题同时作用于窗口外壳、侧边栏与页面内容。"
					           Style="{StaticResource SectionHint}" />
					<Grid x:Name="ThemeGrid" ColumnSpacing="10" RowSpacing="10" Margin="0,4,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
					</Grid>
				</StackPanel>
			</Border>

			<!-- ── 显示与搜索 ────────────────────────────────────── -->
			<Border x:Name="CardSearch" Style="{StaticResource SettingsCard}">
				<StackPanel Spacing="10">
					<TextBlock Text="显示与搜索" Style="{StaticResource SectionTitle}" />
					<TextBlock Text="控制列表与查询页显示哪些信息、支持哪些关键词。"
					           Style="{StaticResource SectionHint}" />
					<StackPanel x:Name="SearchRows" />
					<Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
					<Grid ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Spacing="2" VerticalAlignment="Center">
							<TextBlock Text="自定义搜索词" FontSize="13.5" />
							<TextBlock Text="给自己常用的外号 / 简称建别名，搜索时一并命中"
							           FontSize="11.5" Opacity="0.58" TextWrapping="Wrap" />
						</StackPanel>
						<Button Grid.Column="1" Content="管理" Click="OnCustomWordsClick"
						        VerticalAlignment="Center" />
					</Grid>
				</StackPanel>
			</Border>

			<!-- ── 干员头像个性化 ─────────────────────────────────── -->
			<Border x:Name="CardAvatar" Style="{StaticResource SettingsCard}">
				<StackPanel Spacing="10">
					<TextBlock Text="干员头像个性化" Style="{StaticResource SectionTitle}" />
					<TextBlock Text="判定顺序：精一名单 &gt; 精二名单 &gt; 条件规则（自上而下首条命中）&gt; 默认优先级。没有精二头像的干员始终回落精一。"
					           Style="{StaticResource SectionHint}" />

					<Grid Margin="0,4,0,0" ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Spacing="2" VerticalAlignment="Center">
							<TextBlock Text="默认头像优先级" FontSize="13.5" />
							<TextBlock Text="没有被下面任何规则或名单命中时使用" FontSize="11.5" Opacity="0.58" />
						</StackPanel>
						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
						            VerticalAlignment="Center">
							<ToggleButton x:Name="AvatarE1" Content="优先精一" Tag="0"
							              Click="OnAvatarLevelClick" MinWidth="84" />
							<ToggleButton x:Name="AvatarE2" Content="优先精二" Tag="2"
							              Click="OnAvatarLevelClick" MinWidth="84" />
						</StackPanel>
					</Grid>

					<Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

					<Grid ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Spacing="2" VerticalAlignment="Center">
							<TextBlock Text="条件规则" FontSize="13.5" />
							<TextBlock Text="按干员属性或盒属性决定档位，自上而下第一条命中的规则生效"
							           FontSize="11.5" Opacity="0.58" TextWrapping="Wrap" />
						</StackPanel>
						<Button Grid.Column="1" Content="＋ 新增规则" Click="OnAddRuleClick"
						        VerticalAlignment="Center" />
					</Grid>
					<StackPanel x:Name="AvatarRules" Spacing="6" />
					<TextBlock x:Name="AvatarRulesEmpty" Text="暂无规则，全部干员使用上方默认优先级"
					           FontSize="11.5" Opacity="0.5" />

					<Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

					<Grid ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Spacing="2" VerticalAlignment="Center">
							<TextBlock Text="精二名单" FontSize="13.5" />
							<TextBlock Text="名单内的干员无视规则，始终优先精二头像"
							           FontSize="11.5" Opacity="0.58" TextWrapping="Wrap" />
						</StackPanel>
						<Button Grid.Column="1" Content="＋ 添加" Click="OnAddWhiteClick"
						        VerticalAlignment="Center" />
					</Grid>
					<StackPanel x:Name="AvatarWhite" Spacing="6" />
					<TextBlock x:Name="AvatarWhiteEmpty" Text="暂无干员" FontSize="11.5" Opacity="0.5" />

					<Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

					<Grid ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Spacing="2" VerticalAlignment="Center">
							<TextBlock Text="精一名单" FontSize="13.5" />
							<TextBlock Text="名单内的干员无视规则，始终展示精一头像"
							           FontSize="11.5" Opacity="0.58" TextWrapping="Wrap" />
						</StackPanel>
						<Button Grid.Column="1" Content="＋ 添加" Click="OnAddBlackClick"
						        VerticalAlignment="Center" />
					</Grid>
					<StackPanel x:Name="AvatarBlack" Spacing="6" />
					<TextBlock x:Name="AvatarBlackEmpty" Text="暂无干员" FontSize="11.5" Opacity="0.5" />

					<Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

					<Grid ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Spacing="2" VerticalAlignment="Center">
							<TextBlock Text="导入 / 导出" FontSize="13.5" />
							<TextBlock Text="整份设置导出成 JSON 文本，换机后粘贴导入即可"
							           FontSize="11.5" Opacity="0.58" TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
						            VerticalAlignment="Center">
							<Button Content="导出" Click="OnExportAvatarClick" />
							<Button Content="导入" Click="OnImportAvatarClick" />
							<Button Content="恢复默认" Click="OnResetAvatarClick" />
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

			<!-- ── 数据 ───────────────────────────────────────────── -->
			<Border x:Name="CardData" Style="{StaticResource SettingsCard}">
				<StackPanel Spacing="10">
					<TextBlock Text="数据" Style="{StaticResource SectionTitle}" />
					<TextBlock Text="Windows 版的数据随程序一起分发，不再跳到手机端的设置页。"
					           Style="{StaticResource SectionHint}" />

					<StackPanel Spacing="2" Margin="0,4,0,0">
						<TextBlock Text="当前数据源" FontSize="13.5" />
						<TextBlock x:Name="DataSourceText" Text="—" FontSize="11.5" Opacity="0.6" />
					</StackPanel>

					<StackPanel x:Name="DataRows" />
				</StackPanel>
			</Border>

			<!-- ── 窗口与启动 ────────────────────────────────────── -->
			<Border x:Name="CardWindow" Style="{StaticResource SettingsCard}">
				<StackPanel Spacing="10">
					<TextBlock Text="窗口与启动" Style="{StaticResource SectionTitle}" />
					<TextBlock Text="这些是 Windows 版独有的桌面能力。"
					           Style="{StaticResource SectionHint}" />
					<StackPanel x:Name="WindowRows" />
					<Button Content="重新运行首次设置向导" Click="OnRunSetupClick" Margin="0,6,0,0" />
				</StackPanel>
			</Border>

			<!-- ── 关于 ───────────────────────────────────────────── -->
			<Border x:Name="CardAbout" Style="{StaticResource SettingsCard}">
				<StackPanel Spacing="10">
					<TextBlock Text="关于" Style="{StaticResource SectionTitle}" />

					<Grid Margin="0,4,0,0" ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Spacing="2">
							<TextBlock Text="方舟通行证谷子查询工具" FontSize="13.5" />
							<TextBlock x:Name="VersionText" Text="—" FontSize="11.5" Opacity="0.6" />
							<TextBlock x:Name="FontText" Text="" FontSize="11" Opacity="0.45" />
						</StackPanel>
						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
						            VerticalAlignment="Center">
							<Button x:Name="CheckUpdateButton" Content="检查更新" Click="OnCheckUpdateClick" />
							<Button Content="关于我们" Click="OnAboutClick" />
							<Button Content="项目主页" Click="OnOpenRepoClick" />
						</StackPanel>
					</Grid>

					<StackPanel x:Name="UpdatePanel" Spacing="3" Visibility="Collapsed">
						<TextBlock x:Name="UpdateText" FontSize="12" TextWrapping="Wrap" Opacity="0.65" />
						<ProgressBar x:Name="UpdateProgress" Height="3" Minimum="0" Maximum="100"
						             Visibility="Collapsed" />
						<StackPanel Orientation="Horizontal" Spacing="16">
							<HyperlinkButton x:Name="UpdateLink" Content="前往下载" Padding="0"
							                 Visibility="Collapsed" Click="OnDownloadUpdateClick" />
							<HyperlinkButton x:Name="UpdateCancelLink" Content="取消下载" Padding="0"
							                 Visibility="Collapsed" Click="OnCancelDownloadClick" />
						</StackPanel>
					</StackPanel>

					<Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
					<TextBlock Text="本程序为第三方工具，与鹰角网络无关。数据版权归原作者所有。"
					           FontSize="11.5" Opacity="0.55" TextWrapping="Wrap" />
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
